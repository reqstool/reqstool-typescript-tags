{
    "name": "@reqstool/reqstool-typescript-tags",
    "version": "0.0.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reqstool/reqstool-typescript-tags.git"
    },
    "type": "module",
    "files": [
        "dist"
    ],
    "bin": {
        "reqstool-typescript-tags": "dist/index.js"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "lint": "eslint '{src,tests/unit}/**/*.{js,ts}'",
        "format": "prettier --check '**/*.{js,ts,json,md}'",
        "test": "vitest run",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "dev": "NODE_NO_WARNINGS=1 node --loader ts-node/esm ./src/index.ts"
    },
    "keywords": [
        "reqstool",
        "tags processor"
    ],
    "author": "reqstool",
    "license": "MIT",
    "description": "Library for processing reqstool tags",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/js-yaml": "4.0.9",
        "@types/node": "24.13.2",
        "eslint": "10.5.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.8.4",
        "ts-node": "10.9.2",
        "typescript-eslint": "8.61.0",
        "vitest": "4.1.9"
    },
    "dependencies": {
        "commander": "14.0.3",
        "fast-glob": "3.3.3",
        "js-yaml": "4.2.0",
        "typescript": "6.0.3"
    }
}
