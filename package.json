{
    "name": "@reqstool/reqstool-typescript-tags",
    "version": "0.1.1",
    "type": "module",
    "files": [
        "dist"
    ],
    "bin": {
        "reqstool-typescript-tags": "dist/index.js"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "lint": "eslint '{src,tests/unit}/**/*.{js,ts}'",
        "format": "prettier --check '**/*.{js,ts,json,md}'",
        "test": "vitest run",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "dev": "NODE_NO_WARNINGS=1 node --loader ts-node/esm ./src/index.ts "
    },
    "keywords": [
        "reqstool",
        "tags processor"
    ],
    "author": "reqstool",
    "license": "MIT",
    "description": "Library for processing reqstool tags",
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.0.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.45.0",
        "vitest": "^4.0.0"
    },
    "dependencies": {
        "commander": "^14.0.1",
        "fast-glob": "^3.3.3",
        "js-yaml": "^4.1.0"
    }
}
